<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <Configurations>Debug;Release;Linux ARM;Linux x64</Configurations>
    <Platforms>AnyCPU;ARM64;x64</Platforms>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Linux ARM|AnyCPU'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Linux ARM|x64'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Linux x64|AnyCPU'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Linux x64|x64'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Linux ARM|ARM64'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Linux x64|ARM64'">
    <DefineConstants>$(DefineConstants);DSS;PCGAME</DefineConstants>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Content\DSS\Map\**" />
    <Compile Remove="LF2\**" />
    <EmbeddedResource Remove="Content\DSS\Map\**" />
    <EmbeddedResource Remove="LF2\**" />
    <None Remove="Content\DSS\Map\**" />
    <None Remove="LF2\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="DSSWars\Presentation\Swedish.cs" />
    <Compile Remove="EngineSpace\Translation\OptionsLanguage_Swedish.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Content\DSS\Music\Endless Plains.mp3" />
    <None Remove="Content\Modding\ModConst.txt" />
    <None Remove="Content\Shaders\OceanEffect.fx" />
    <None Remove="Content\Shaders\OceanShaderTest.fx" />
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
    <None Remove="steam_api64.dll" />
    <None Remove="VikingEngine-linux-x64.tar.gz" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Content\Modding\ModConst.txt" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Icon.ico" />
  </ItemGroup>
  <ItemGroup>

    	<EmbeddedResource Include="Icon.ico">
		<LogicalName>Icon.ico</LogicalName>
	</EmbeddedResource>

    	<EmbeddedResource Include="Icon.bmp">
  		<LogicalName>Icon.bmp</LogicalName>
	</EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.3" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Sentry" Version="5.7.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\monogame\MonoGame\MonoGame.Framework\MonoGame.Framework.DesktopGL.csproj">
      <Properties Condition="'$(Configuration)' == 'Release'">Platform=x64</Properties>
    </ProjectReference>
    <ProjectReference Include="..\..\..\SteamworksNet\Steamworks.NET\Standalone2.0\Steamworks.NET.Standard.csproj">
        <Properties Condition="'$(Configuration)' == 'Release'">Platform=x64</Properties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Content\VoxelModel\Temp\" />
  </ItemGroup>
  
  <PropertyGroup>
    <MonoGamePlatform>DesktopGL</MonoGamePlatform>
    <PlatformTarget>x64</PlatformTarget>
</PropertyGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>